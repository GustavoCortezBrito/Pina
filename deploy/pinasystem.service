[Unit]
Description=PinaSystem (Next.js)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/pinasystem
EnvironmentFile=/opt/pinasystem/.env
Environment=PORT=3000
# Escuta só em localhost: quem atende a internet é o Caddy (com HTTPS). Assim, mesmo que o firewall
# seja desligado por engano, a porta 3000 não fica exposta.
ExecStart=/usr/bin/node /opt/pinasystem/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
# Arquivos criados pelo sistema (fotos, documentos) ficam legíveis só para o próprio usuário.
UMask=0077

# Isolamento: reduz o estrago se algum dia o processo for comprometido.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pinasystem /var/lib/pinasystem
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
