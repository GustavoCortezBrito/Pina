[Unit]
Description=PinaSystem (Next.js)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/pinasystem
EnvironmentFile=/opt/pinasystem/.env
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
# Endurecimento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/pinasystem /var/lib/pinasystem

[Install]
WantedBy=multi-user.target
