# Copie para /opt/pinasystem/.env na VPS (chmod 600). NUNCA commite o .env real.

NODE_ENV="production"

# PostgreSQL instalado no próprio servidor (só localhost)
DATABASE_URL="postgresql://pina:TROQUE-POR-UMA-SENHA-FORTE@localhost:5432/pinasystem"
EMBEDDED_POSTGRES="false"

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="gere-um-valor-aleatorio-de-32-bytes"
BETTER_AUTH_URL="https://sistema.seudominio.com.br"
# Endereços extras permitidos para login (opcional, separados por vírgula). Ex.: túnel de teste.
# TRUSTED_ORIGINS="https://exemplo.ngrok-free.app"

# Fotos e documentos (fora da pasta do código, para sobreviver aos deploys)
STORAGE_LOCAL_PATH="/var/lib/pinasystem/uploads"

# Administrador inicial (usado por `npm run db:seed`)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@seudominio.com.br"
ADMIN_PASSWORD="troque-esta-senha"
