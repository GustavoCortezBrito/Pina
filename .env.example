# ───────── Banco de dados ─────────
# Em desenvolvimento, `npm run dev` sobe um PostgreSQL embutido com este usuário, senha e porta.
# Na VPS, aponte para o PostgreSQL instalado no servidor.
DATABASE_URL="postgresql://pina:pina@localhost:5433/pinasystem"

# Pasta onde o Postgres embutido guarda os dados (evite pastas do OneDrive/Dropbox).
# Padrão: ~/.pinasystem/postgres
# PGDATA_DIR=""

# Use "false" para NÃO subir o Postgres embutido (ex.: banco externo, VPS, Supabase).
EMBEDDED_POSTGRES="true"

# ───────── Autenticação ─────────
# Gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="troque-por-um-valor-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# ───────── Arquivos (fotos e documentos) ─────────
STORAGE_LOCAL_PATH="./storage/uploads"

# ───────── Administrador inicial (usado por `npm run db:seed`) ─────────
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@pinas.com.br"
ADMIN_PASSWORD="troque-esta-senha"
